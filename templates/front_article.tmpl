{{define "front_article"}}
{{template "front_layout_head" .}}
    <a href="/" class="text-decoration-none text-muted">&laquo; 返回首页</a>
    <article class="article-body mt-3">
        <h1 class="mb-2">{{.article.Title}}</h1>
        <div class="post-meta mb-3">
            {{.article.AuthorInfo.NickName}} · {{.article.CreateTime.Format "2006-01-02 15:04"}}
        </div>
        {{if .tags}}
        <div class="mb-3">
            {{range $t := .tags}}<a class="tag-badge" href="/tag/{{$t.Id}}">{{$t.TagName}}</a>{{end}}
        </div>
        {{end}}
        <hr>
        <div class="content">
            {{.contentHTML}}
        </div>
    </article>
{{template "front_layout_foot" .}}
{{end}}
