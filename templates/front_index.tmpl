{{define "front_index"}}
{{template "front_layout_head" .}}
    {{range $a := .articles}}
    <article class="post-card">
        <h2><a href="/article/{{$a.Id}}">{{$a.Title}}</a></h2>
        <div class="post-meta">
            {{$a.AuthorInfo.NickName}} · {{$a.UpdateTime.Format "2006-01-02"}}
        </div>
        <div class="post-brief">{{$a.Brief}}</div>
    </article>
    {{else}}
    <p class="text-muted">还没有已发布的文章。</p>
    {{end}}

    {{if or .hasPrev .hasNext}}
    <nav class="d-flex justify-content-between my-4">
        {{if .hasPrev}}<a class="btn btn-outline-secondary" href="/?page={{.prevPage}}">&laquo; 上一页</a>{{else}}<span></span>{{end}}
        <span class="text-muted">第 {{.page}} / {{.totalPage}} 页</span>
        {{if .hasNext}}<a class="btn btn-outline-secondary" href="/?page={{.nextPage}}">下一页 &raquo;</a>{{else}}<span></span>{{end}}
    </nav>
    {{end}}
{{template "front_layout_foot" .}}
{{end}}
