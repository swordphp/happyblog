{{define "front_layout_head"}}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{.sitename}}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="alternate" type="application/rss+xml" title="{{.sitename}}" href="/api/rss">
    <style>
        body { background:#fafafa; color:#222; }
        .site-header { background:#fff; border-bottom:1px solid #eee; padding:18px 0; margin-bottom:28px; }
        .site-header h1 { margin:0; font-size:24px; }
        .site-header a { color:#222; text-decoration:none; }
        .site-desc { color:#888; font-size:14px; }
        .post-card { background:#fff; border:1px solid #eee; border-radius:8px; padding:20px 24px; margin-bottom:18px; }
        .post-card h2 { font-size:20px; margin:0 0 8px; }
        .post-card h2 a { color:#1a1a1a; text-decoration:none; }
        .post-card h2 a:hover { color:#0d6efd; }
        .post-meta { color:#999; font-size:13px; margin-bottom:8px; }
        .post-brief { color:#555; }
        .article-body { background:#fff; border:1px solid #eee; border-radius:8px; padding:32px 40px; }
        .article-body img { max-width:100%; }
        .article-body pre { background:#f6f8fa; padding:14px; border-radius:6px; overflow:auto; }
        .article-body code { background:#f0f0f0; padding:2px 5px; border-radius:4px; }
        .article-body pre code { background:transparent; padding:0; }
        .tag-badge { display:inline-block; background:#eef; color:#36c; border-radius:4px; padding:2px 8px; font-size:12px; margin-right:6px; }
        footer { color:#aaa; text-align:center; padding:40px 0 24px; font-size:13px; }
    </style>
</head>
<body>
<header class="site-header">
    <div class="container">
        <h1><a href="/">{{.sitename}}</a></h1>
        {{if .sitedesc}}<div class="site-desc">{{.sitedesc}}</div>{{end}}
    </div>
</header>
<main class="container">
{{end}}

{{define "front_layout_foot"}}
</main>
<footer>Powered by HappyBlog · <a href="/api/rss">RSS</a></footer>
</body>
</html>
{{end}}
